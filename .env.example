# Required for conversational AI coaching. Never expose this in the browser.
OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional. OpenAI text-to-speech model for the OpenAI coach voices.
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Required for the ElevenLabs "Ramesh" voice. The SDK reads this server-side.
# Prefer `npx -y @elevenlabs/cli@latest onboard init` over pasting the key by hand.
ELEVENLABS_API_KEY=

# Optional. ElevenLabs text-to-speech model. Ramesh defaults to eleven_v4.
ELEVENLABS_TTS_MODEL=eleven_v4

# Optional. Use an OpenAI-compatible endpoint only if you know it supports chat completions streaming.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Defaults to 12. Higher depths are more accurate but take longer.
STOCKFISH_DEPTH=12
